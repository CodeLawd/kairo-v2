<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!-- kairo-engine (output process), hardened runtime. It draws the screens,
     captures cameras and their sound (057), and loads the re-signed NDI
     runtime from Contents/Frameworks. No JIT, no library-validation
     exception (DECISIONS.md 101). -->
<plist version="1.0">
<dict>
  <key>com.apple.security.device.camera</key>
  <true/>
  <key>com.apple.security.device.audio-input</key>
  <true/>
</dict>
</plist>
